DB_DSN=postgresql://user:password@postgres-db:5432/database
# 既定ギルド (ギルド設定はguildsテーブルで管理し、これはHost解決のフォールバック先)
GUILD_ID=1355073968532619376
# これらのHostは既定ギルドへフォールバックする (カンマ区切り)
DEFAULT_GUILD_HOSTS=api.ymkw.top,localhost,127.0.0.1,::1,ymkw-backend
API_SECRET=replace-with-at-least-32-random-characters
ADMIN_SESSION_SECRET=replace-with-another-32-character-random-secret
ADMIN_PASSWORD_HASH=pbkdf2-sha256$600000$base64url-salt$base64url-hash
TRUST_CLOUDFLARE_PROXY=false
CLOUDFLARE_TRUSTED_PROXY_CIDRS=
ENABLE_API_DOCS=false
ADMIN_LOGIN_GLOBAL_LIMIT=20
CACHE_SIZE_LIMIT_BYTES=268435456

# AI機能 (/ai)。DEEPSEEK_API_KEY未設定ならAIは無効になる
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com
AI_AGENT_SOCKET=
AI_REQUIRE_ADMIN=false
AI_RATE_LIMIT_PER_10MIN=20
AI_DAILY_LIMIT_PER_IP=100
AI_DAILY_LIMIT_GLOBAL=1000
